{
  "name": "bbbbb",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Private iPhone alerts from commands, coding agents, and services",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @bbbbbapp/protocol && npm run build --workspace @bbbbbapp/cli && npm run build --workspace @bbbbbapp/relay",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run build && npm run typecheck && npm test",
    "test:packaging": "node --test scripts/release/*.test.mjs",
    "build:cli-distributions": "node scripts/release/build-cli-distributions.mjs",
    "check:cli-distributions": "bash scripts/release/check-cli-distributions.sh",
    "check:public-core": "bash scripts/check-public-core.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@types/node": "22.20.1",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "wrangler": "4.121.0"
  }
}
